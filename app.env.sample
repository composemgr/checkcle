# CheckCle app environment
# Copy to app.env and fill in your values

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=checkcle.example.com
BASE_DOMAIN_NAME=example.com

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=checkcle
DB_USER_NAME=checkcle
DB_USER_PASS=replace-with-a-random-password
